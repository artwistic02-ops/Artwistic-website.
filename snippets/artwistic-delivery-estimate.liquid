{% comment %}
  ARTWISTIC: manual, no-API delivery estimate calculator. The shopper
  enters their pincode; JS maps its prefix to a region (Gujarat/Mumbai =
  faster transit, everywhere else = slower) and computes an estimated
  delivery date range client-side using merchant-configured business-day
  rules (block settings below) — no courier API, no live pincode
  serviceability check.

  Visual: a 3-tier "Order now / Dispatches / Delivered" stepper, matching
  the approved product-page mockup, with a left-to-right reveal animation
  once a valid pincode is checked. The tier row is decorative/
  aria-hidden; the visually-hidden status paragraph carries the real
  live-announced result for screen readers.

  Usage:
    {% render 'artwistic-delivery-estimate', block: block %}
{% endcomment %}

{{ 'artwistic-delivery-estimate.css' | asset_url | stylesheet_tag }}
<script src="{{ 'artwistic-delivery-estimate.js' | asset_url }}" defer="defer"></script>

<div
  class="aw-delivery-estimate"
  data-aw-delivery-estimate
  data-dispatch-min="{{ block.settings.dispatch_days_min | default: 1 }}"
  data-dispatch-max="{{ block.settings.dispatch_days_max | default: 2 }}"
  data-transit-fast-min="{{ block.settings.transit_fast_min | default: 1 }}"
  data-transit-fast-max="{{ block.settings.transit_fast_max | default: 2 }}"
  data-transit-other-min="{{ block.settings.transit_other_min | default: 4 }}"
  data-transit-other-max="{{ block.settings.transit_other_max | default: 6 }}"
  data-holidays="{{ block.settings.holiday_dates | strip_newlines | escape }}"
  {{ block.shopify_attributes }}
>
  <div class="aw-delivery-estimate__row">
    <input
      type="tel"
      inputmode="numeric"
      autocomplete="postal-code"
      pattern="[0-9]*"
      maxlength="6"
      id="AwDeliveryPincode-{{ block.id }}"
      class="aw-delivery-estimate__input"
      aria-label="{{ block.settings.label | default: 'Check estimated delivery' }}"
      data-aw-delivery-pincode
      data-aw-typing-hint="{{ block.settings.hint_text | default: 'Enter pincode to check delivery' }}"
    >
    <button type="button" class="aw-delivery-estimate__check" data-aw-delivery-check>Check</button>
  </div>
  <p class="aw-delivery-estimate__error" data-aw-delivery-error hidden>Enter a valid 6-digit pincode.</p>
  <div class="aw-tier-row" data-aw-tier-row data-aw-motion hidden aria-hidden="true">
    <div class="aw-tier-track">
      <div class="aw-tier-track__fill" data-aw-tier-fill></div>
    </div>
    <div class="aw-tier" data-tier="1" data-aw-tier-order>
      <span class="aw-tier__icon aw-tier__icon--order">
        {{- 'icon-padlock.svg' | inline_asset_content -}}
      </span>
      <span class="aw-tier__label">Order now</span>
      <span class="aw-tier__date">Today</span>
    </div>
    <div class="aw-tier" data-tier="2" data-aw-tier-dispatch>
      <span class="aw-tier__icon aw-tier__icon--dispatch">
        {{- 'icon-truck.svg' | inline_asset_content -}}
      </span>
      <span class="aw-tier__label">Dispatches</span>
      <span class="aw-tier__date" data-aw-tier-dispatch-date>&mdash;</span>
    </div>
    <div class="aw-tier" data-tier="3" data-aw-tier-delivered>
      <span class="aw-tier__icon aw-tier__icon--delivered">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 11.5 12 4l9 7.5"></path>
          <path d="M5.5 10v9a1 1 0 0 0 1 1H10v-5.5h4V20h3.5a1 1 0 0 0 1-1v-9"></path>
        </svg>
      </span>
      <span class="aw-tier__label">Delivered</span>
      <span class="aw-tier__date" data-aw-tier-delivered-date>&mdash;</span>
    </div>
  </div>
  <p class="aw-delivery-estimate__result aw-visually-hidden" data-aw-delivery-result role="status"></p>
</div>
