{% comment %}
  ARTWISTIC: one product-specific FAQ entry, reusing Dawn's native
  accordion markup/classes (same zero-JS <details> pattern as the
  material accordion). Each block is its own independent accordion item
  — matching how Dawn's own `collapsible_tab` block behaves.

  Usage:
    {% render 'artwistic-faq-item', block: block %}
{% endcomment %}

{%- if block.settings.question != blank and block.settings.answer != blank -%}
  <div class="product__accordion accordion quick-add-hidden" {{ block.shopify_attributes }}>
    <details id="ARTWISTIC-FAQ-{{ block.id }}">
      <summary>
        <div class="summary__title">
          <h2 class="h4 accordion__title">{{ block.settings.question | escape }}</h2>
        </div>
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </summary>
      <div class="accordion__content rte">
        {{ block.settings.answer }}
      </div>
    </details>
  </div>
{%- endif -%}
