{% comment %}
  ARTWISTIC: breadcrumb trail + BreadcrumbList structured data. Dawn ships
  no breadcrumbs at all (spec sections 37/44 both call for them), so this
  is genuinely new, not a restyle of an existing Dawn component. Infers
  the trail from whichever global objects are available for the current
  template — no required parameters.

  Usage:
    {% render 'artwistic-breadcrumbs' %}
{% endcomment %}

{%- liquid
  assign aw_home_title = 'Home'
  assign aw_context_collection = collection
  if request.page_type == 'product' and aw_context_collection == blank and product.collections.size > 0
    assign aw_context_collection = product.collections.first
  endif
-%}

{%- if request.page_type == 'collection' or request.page_type == 'product' or request.page_type == 'article' or request.page_type == 'blog' -%}
  <nav class="aw-breadcrumbs" aria-label="Breadcrumb">
    <ol class="aw-breadcrumbs__list">
      <li class="aw-breadcrumbs__item">
        <a href="{{ routes.root_url }}">{{ aw_home_title }}</a>
      </li>
      {%- if request.page_type == 'product' and aw_context_collection != blank -%}
        <li class="aw-breadcrumbs__item">
          <a href="{{ aw_context_collection.url }}">{{ aw_context_collection.title | escape }}</a>
        </li>
        <li class="aw-breadcrumbs__item aw-breadcrumbs__item--current" aria-current="page">{{ product.title | escape }}</li>
      {%- elsif request.page_type == 'product' -%}
        <li class="aw-breadcrumbs__item aw-breadcrumbs__item--current" aria-current="page">{{ product.title | escape }}</li>
      {%- elsif request.page_type == 'collection' -%}
        <li class="aw-breadcrumbs__item aw-breadcrumbs__item--current" aria-current="page">{{ collection.title | escape }}</li>
      {%- elsif request.page_type == 'article' -%}
        <li class="aw-breadcrumbs__item">
          <a href="{{ blog.url }}">{{ blog.title | escape }}</a>
        </li>
        <li class="aw-breadcrumbs__item aw-breadcrumbs__item--current" aria-current="page">{{ article.title | escape }}</li>
      {%- elsif request.page_type == 'blog' -%}
        <li class="aw-breadcrumbs__item aw-breadcrumbs__item--current" aria-current="page">{{ blog.title | escape }}</li>
      {%- endif -%}
    </ol>
  </nav>

  {%- comment -%} BreadcrumbList structured data — mirrors the visible trail above exactly. {%- endcomment -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {{ aw_home_title | json }},
          "item": {{ shop.url | append: routes.root_url | json }}
        }
        {%- if request.page_type == 'product' and aw_context_collection != blank -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ aw_context_collection.title | json }},
            "item": {{ shop.url | append: aw_context_collection.url | json }}
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": {{ product.title | json }},
            "item": {{ shop.url | append: product.url | json }}
          }
        {%- elsif request.page_type == 'product' -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ product.title | json }},
            "item": {{ shop.url | append: product.url | json }}
          }
        {%- elsif request.page_type == 'collection' -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ collection.title | json }},
            "item": {{ shop.url | append: collection.url | json }}
          }
        {%- elsif request.page_type == 'article' -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ blog.title | json }},
            "item": {{ shop.url | append: blog.url | json }}
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": {{ article.title | json }},
            "item": {{ shop.url | append: article.url | json }}
          }
        {%- elsif request.page_type == 'blog' -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ blog.title | json }},
            "item": {{ shop.url | append: blog.url | json }}
          }
        {%- endif -%}
      ]
    }
  </script>
{%- endif -%}
