{% comment %}
  ARTWISTIC: real breadcrumb trail — Home / [ancestor collection] / [current
  page]. Real Shopify data only: product.collections.first for the
  product-page ancestor, collection.title on collection pages. Renders
  nothing beyond "Home" when no real ancestor exists — no fabricated
  category names.
{% endcomment %}
<nav class="aw-breadcrumbs" aria-label="Breadcrumb">
  <a href="{{ routes.root_url }}">Home</a>
  {%- if template contains 'collection' and collection -%}
    <span class="aw-breadcrumbs__sep" aria-hidden="true">/</span>
    <span class="aw-breadcrumbs__current" aria-current="page">{{ collection.title }}</span>
  {%- elsif template contains 'product' and product -%}
    {%- assign aw_ancestor = product.collections.first -%}
    {%- if aw_ancestor -%}
      <span class="aw-breadcrumbs__sep" aria-hidden="true">/</span>
      <a href="{{ aw_ancestor.url }}">{{ aw_ancestor.title }}</a>
    {%- endif -%}
    <span class="aw-breadcrumbs__sep" aria-hidden="true">/</span>
    <span class="aw-breadcrumbs__current" aria-current="page">{{ product.title }}</span>
  {%- elsif page_title -%}
    <span class="aw-breadcrumbs__sep" aria-hidden="true">/</span>
    <span class="aw-breadcrumbs__current" aria-current="page">{{ page_title }}</span>
  {%- endif -%}
</nav>
