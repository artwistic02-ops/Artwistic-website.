{% comment %}
  ARTWISTIC: floating quick-actions over a product card image —
  wishlist toggle (localStorage, assets/artwistic-product-card.js) and
  add-to-cart. Single-variant products add directly. Products with
  exactly one real option (almost always "Size") open a real quick-add
  picker sheet (assets/artwistic-quick-add.js) fed by the product's
  real variant data embedded below — no guessing, no fabricated
  options. A genuinely multi-option product (e.g. size AND color)
  still falls back to the product page, since there's no safe way to
  resolve two unspecified options from a single tap.

  Accepts:
    card_product
    heart_only: {Boolean} render only the wishlist heart (product page,
      where "Add to bag" is already the real CTA) — optional
    size: 'large' — larger, static (non-floating) heart for heart_only
      use on the product page — optional
{% endcomment %}
{%- if heart_only -%}
  <div class="aw-card-actions{% if size == 'large' %} aw-card-actions--product-page{% endif %}">
    <button
      type="button"
      class="aw-card-action aw-card-action--wishlist{% if size == 'large' %} aw-card-action--large{% endif %}"
      data-aw-wishlist-toggle
      data-product-id="{{ card_product.id }}"
      data-product-handle="{{ card_product.handle }}"
      aria-label="Add {{ card_product.title | escape }} to wishlist"
      aria-pressed="false"
    >
      {{- 'icon-heart.svg' | inline_asset_content -}}
    </button>
  </div>
{%- else -%}
  <div class="aw-card-actions">
    <button
      type="button"
      class="aw-card-action aw-card-action--wishlist"
      data-aw-wishlist-toggle
      data-product-id="{{ card_product.id }}"
      data-product-handle="{{ card_product.handle }}"
      aria-label="{{ 'Add to wishlist' }}"
      aria-pressed="false"
    >
      {{- 'icon-heart.svg' | inline_asset_content -}}
    </button>
    <button
      type="button"
      class="aw-card-action aw-card-action--cart"
      data-aw-quick-add
      data-variant-id="{{ card_product.selected_or_first_available_variant.id }}"
      data-product-url="{{ card_product.url }}"
      data-product-id="{{ card_product.id }}"
      data-multi-variant="{% if card_product.variants_count > 1 %}true{% else %}false{% endif %}"
      aria-label="{{ 'Add to cart' }}"
      {% if card_product.selected_or_first_available_variant.available == false %}
        disabled
      {% endif %}
    >
      <span class="aw-card-action-icon aw-card-action-icon--plus">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
      <span class="aw-card-action-icon aw-card-action-icon--check">{{- 'icon-check-mark.svg' | inline_asset_content -}}</span>
      {%- render 'loading-spinner' -%}
    </button>

    {%- if card_product.variants_count > 1 and card_product.options.size == 1 -%}
      {%- assign aw_qa_option = card_product.options_with_values.first -%}
      <script type="application/json" data-aw-quick-add-data="{{ card_product.id }}">
        {
          "productId": {{ card_product.id | json }},
          "title": {{ card_product.title | json }},
          "image": {{ card_product.featured_image | image_url: width: 200 | json }},
          "optionName": {{ aw_qa_option.name | json }},
          "values": [
            {%- for aw_val in aw_qa_option.values -%}
              {%- assign aw_qa_variant = null -%}
              {%- for aw_v in card_product.variants -%}
                {%- if aw_v.option1 == aw_val -%}
                  {%- assign aw_qa_variant = aw_v -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}
              {
                "label": {{ aw_val | json }},
                "variantId": {{ aw_qa_variant.id | json }},
                "available": {{ aw_qa_variant.available | json }},
                "price": {{ aw_qa_variant.price | json }}
              }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]
        }
      </script>
    {%- endif -%}
  </div>
{%- endif -%}
