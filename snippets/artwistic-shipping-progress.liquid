{% comment %}
  ARTWISTIC: two-tier cart progress — free standard shipping above ₹1,499
  (Artwistic's real, confirmed policy, see docs/SHOPIFY_ADMIN_SETUP.md) and
  a free-gift milestone above ₹2,499. Both thresholds are computed entirely
  from cart.total_price — no fabricated math. The ₹2,499 free-gift tier is
  UI/messaging only: it does not add any item to the cart by itself. Set up
  the actual gift (an automatic "Buy X get Y" discount, or a $0 gift
  variant) in Shopify Admin — this bar just tells the shopper when they've
  crossed the line the merchant has separately configured. Keep both
  numbers below in sync with real policy if either ever changes.

  Because Dawn's cart drawer/cart page re-fetch and re-render this section's
  markup from the server on every cart change (see cart.js/cart-drawer.js),
  this progress bar updates automatically with zero custom JS math; the
  unlock celebration (assets/artwistic-shipping-progress.js) detects the
  moment either tier's "reached" class newly appears.

  Usage:
    {% render 'artwistic-shipping-progress' %}
{% endcomment %}

{%- liquid
  assign aw_shipping_threshold = 149900
  assign aw_gift_threshold = 249900
  assign aw_percent = cart.total_price | times: 100 | divided_by: aw_gift_threshold
  if aw_percent > 100
    assign aw_percent = 100
  endif
  assign aw_shipping_reached = false
  assign aw_gift_reached = false
  if cart.total_price >= aw_shipping_threshold
    assign aw_shipping_reached = true
  endif
  if cart.total_price >= aw_gift_threshold
    assign aw_gift_reached = true
  endif
  assign aw_shipping_position = aw_shipping_threshold | times: 100 | divided_by: aw_gift_threshold
-%}

<div class="aw-shipping-progress" role="status" aria-live="polite" data-aw-motion>
  {%- if aw_gift_reached -%}
    <p class="aw-shipping-progress__message aw-shipping-progress__message--unlocked">
      <span class="aw-icon-sm aw-shipping-progress__icon">{{- 'icon-checkmark.svg' | inline_asset_content -}}</span>
      You've unlocked free shipping and a free gift
    </p>
  {%- elsif aw_shipping_reached -%}
    {%- assign aw_gift_remaining = aw_gift_threshold | minus: cart.total_price -%}
    <p class="aw-shipping-progress__message aw-shipping-progress__message--unlocked">
      <span class="aw-icon-sm aw-shipping-progress__icon">{{- 'icon-checkmark.svg' | inline_asset_content -}}</span>
      Free shipping unlocked &mdash; <strong>{{ aw_gift_remaining | money }}</strong> more for a free gift
    </p>
  {%- else -%}
    {%- assign aw_shipping_remaining = aw_shipping_threshold | minus: cart.total_price -%}
    <p class="aw-shipping-progress__message">
      <strong>{{ aw_shipping_remaining | money }}</strong> away from free standard shipping
    </p>
  {%- endif -%}

  <div class="aw-shipping-progress__track-row">
    <div class="aw-shipping-progress__track">
      <div class="aw-shipping-progress__fill" style="width: {{ aw_percent }}%;"></div>
    </div>
    <div
      class="aw-shipping-progress__node{% if aw_shipping_reached %} aw-shipping-progress__node--reached{% endif %}"
      style="left: {{ aw_shipping_position }}%;"
      aria-hidden="true"
    >
      {{- 'icon-truck.svg' | inline_asset_content -}}
    </div>
    <div
      class="aw-shipping-progress__node aw-shipping-progress__node--end{% if aw_gift_reached %} aw-shipping-progress__node--reached{% endif %}"
      aria-hidden="true"
    >
      {{- 'icon-box.svg' | inline_asset_content -}}
    </div>
  </div>
  <div class="aw-shipping-progress__labels">
    <span>{{ aw_shipping_threshold | money }} &middot; Free shipping</span>
    <span>{{ aw_gift_threshold | money }} &middot; Free gift</span>
  </div>
</div>
