{% comment %}
  ARTWISTIC: Wishlist page — reads the real, already-live wishlist data
  layer in assets/artwistic-product-card.js (window.awWishlist, entries
  shaped {id, handle}, event 'aw:wishlist:change'). No new storage
  mechanism — this page is purely a client-side renderer for that
  existing, shared API: it fetches each saved product's real live data
  via /products/<handle>.js and reuses the site's real heart-toggle and
  add-to-cart click-delegation (both already wired in
  artwistic-product-card.js, loaded site-wide from layout/theme.liquid).
{% endcomment %}

{% render 'artwistic-dark-mode-init' %}
{{ 'artwistic-wishlist.css' | asset_url | stylesheet_tag }}
<script src="{{ 'artwistic-wishlist.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'artwistic-dark-mode.js' | asset_url }}" defer="defer"></script>
<script>
  window.Shopify = window.Shopify || {};
  Shopify.money_format = {{ shop.money_format | json }};
</script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: clamp(
      {{ section.settings.padding_top | times: 0.75 | round: 0 }}px,
      {{ section.settings.padding_top | divided_by: 12.8 }}vw,
      {{ section.settings.padding_top }}px
    );
    padding-bottom: clamp(
      {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px,
      {{ section.settings.padding_bottom | divided_by: 12.8 }}vw,
      {{ section.settings.padding_bottom }}px
    );
  }
{%- endstyle -%}

<div class="aw-container aw-wishlist-page color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="aw-wishlist-page__head">
    <div class="aw-wishlist-page__titles">
      <span class="aw-eyebrow">{{ 'general.wishlist.eyebrow' | t }}</span>
      <h1 class="aw-wishlist-page__heading">
        {{ section.settings.heading | default: 'Your wishlist' }}
        <span class="aw-wishlist-page__count" data-aw-wishlist-page-count hidden>0</span>
      </h1>
    </div>
    <div class="aw-wishlist-page__head-actions">
      {% render 'artwistic-dark-mode-toggle' %}
      <button type="button" class="aw-wishlist-page__share" data-aw-wishlist-share hidden>
        {{- 'icon-share.svg' | inline_asset_content -}}
        <span data-aw-wishlist-share-label>{{ 'general.wishlist.share' | t }}</span>
      </button>
    </div>
  </div>

  <div class="aw-wishlist-empty" data-aw-wishlist-empty hidden>
    <p>{{ section.settings.empty_text | default: "Nothing saved yet. Tap the heart on any product to add it here." }}</p>
    <a href="{{ section.settings.empty_link | default: routes.all_products_collection_url }}" class="button button--secondary">
      {{ section.settings.empty_button_label | default: 'Continue shopping' }}
    </a>
  </div>

  <ul class="aw-wishlist-items" data-aw-wishlist-grid hidden role="list"></ul>

  <div class="aw-wishlist-loading" data-aw-wishlist-loading>
    {%- render 'loading-spinner' -%}
  </div>

  <div class="aw-wishlist-summary" data-aw-wishlist-summary hidden>
    <div class="aw-wishlist-summary__row">
      <span class="aw-wishlist-summary__label">{{ 'general.wishlist.value_label' | t }}</span>
      <span class="aw-wishlist-summary__total" data-aw-wishlist-summary-total>—</span>
    </div>
    <p class="aw-wishlist-summary__note">{{ 'general.wishlist.move_all_note' | t }}</p>
    <button type="button" class="aw-wishlist-summary__move-all" data-aw-wishlist-move-all>
      {{- 'icon-cart.svg' | inline_asset_content -}}
      {{ 'general.wishlist.move_all_to_bag' | t }}
    </button>
  </div>

  {%- if section.settings.cross_sell_collection != blank and section.settings.cross_sell_collection.products.size > 0 -%}
    <script src="{{ 'artwistic-rail.js' | asset_url }}" defer="defer"></script>
    <div class="aw-wishlist-cross-sell">
      <div class="aw-wishlist-cross-sell__head">
        <span class="aw-eyebrow">You might also like</span>
        <h2>{{ section.settings.cross_sell_collection.title }}</h2>
      </div>
      <div class="aw-rail-shell">
        <button type="button" class="aw-rail-arrow aw-rail-arrow--prev" data-aw-rail-prev aria-label="Previous">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </button>
        <div class="aw-wishlist-cross-sell__track" data-aw-rail>
          {%- for cs_product in section.settings.cross_sell_collection.products limit: 12 -%}
            {%- assign cs_variant = cs_product.selected_or_first_available_variant -%}
            <div class="aw-wishlist-cross-sell-card">
              <a href="{{ cs_product.url }}" class="aw-wishlist-cross-sell-card__media">
                {%- if cs_product.featured_image != blank -%}
                  {{ cs_product.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200, 300, 400' }}
                {%- endif -%}
              </a>
              <p class="aw-wishlist-cross-sell-card__name">
                <a href="{{ cs_product.url }}" class="full-unstyled-link">{{ cs_product.title | escape }}</a>
              </p>
              <p class="aw-wishlist-cross-sell-card__price">{{ cs_variant.price | money }}</p>
              <button
                type="button"
                class="aw-card-action aw-card-action--cart aw-card-action--large"
                data-aw-quick-add
                data-variant-id="{{ cs_variant.id }}"
                data-product-id="{{ cs_product.id }}"
                data-product-url="{{ cs_product.url }}"
                data-multi-variant="{% if cs_product.variants.size > 1 %}true{% else %}false{% endif %}"
                aria-label="Add {{ cs_product.title | escape }} to cart"
                {% if cs_variant.available == false %}disabled{% endif %}
              >
                <span class="aw-card-action-icon aw-card-action-icon--plus">
                  {{- 'icon-plus.svg' | inline_asset_content -}}
                </span>
                <span class="aw-card-action-icon aw-card-action-icon--check">
                  {{- 'icon-check-mark.svg' | inline_asset_content -}}
                </span>
              </button>
            </div>
          {%- endfor -%}
        </div>
        <button type="button" class="aw-rail-arrow aw-rail-arrow--next" data-aw-rail-next aria-label="Next">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </button>
      </div>
    </div>
  {%- endif -%}
</div>

<template id="aw-wishlist-icon-heart">{{- 'icon-heart.svg' | inline_asset_content -}}</template>
<template id="aw-wishlist-icon-plus">{{- 'icon-plus.svg' | inline_asset_content -}}</template>
<template id="aw-wishlist-icon-check">{{- 'icon-check-mark.svg' | inline_asset_content -}}</template>
<template id="aw-wishlist-icon-remove">{{- 'icon-close.svg' | inline_asset_content -}}</template>
<template id="aw-wishlist-icon-cart">{{- 'icon-cart.svg' | inline_asset_content -}}</template>

{% schema %}
{
  "name": "ARTWISTIC: Wishlist",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your wishlist"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty state text",
      "default": "Nothing saved yet. Tap the heart on any product to add it here."
    },
    {
      "type": "url",
      "id": "empty_link",
      "label": "Empty state link",
      "info": "Defaults to the all-products collection if left blank."
    },
    {
      "type": "text",
      "id": "empty_button_label",
      "label": "Empty state button label",
      "default": "Continue shopping"
    },
    {
      "type": "header",
      "content": "Cross-sell"
    },
    {
      "type": "collection",
      "id": "cross_sell_collection",
      "label": "\"You might also like\" collection",
      "info": "Leave blank to hide this row."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "ARTWISTIC: Wishlist"
    }
  ]
}
{% endschema %}
