{% comment %}
  ARTWISTIC: Wishlist page. Renders an empty state server-side (so the
  page is never blank if JS fails) and a container that
  artwistic-wishlist.js populates client-side by fetching each saved
  product handle from Shopify's Storefront AJAX API
  (/products/{handle}.js) — no app, no server-side account storage.
  See ARTWISTIC_CHANGELOG.md and docs/FEATURE_REGISTER.md.
{% endcomment %}

{{ 'artwistic-wishlist.css' | asset_url | stylesheet_tag }}
{% render 'artwistic-section-padding' %}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
<script src="{{ 'artwistic-wishlist.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'artwistic-wishlist-page.js' | asset_url }}" defer="defer"></script>

<div class="aw-container aw-wishlist-page color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="aw-wishlist-page__head">
    <div class="aw-wishlist-page__titles">
      <span class="aw-eyebrow">{{ 'general.wishlist.eyebrow' | t }}</span>
      <h1 class="aw-wishlist-page__heading">
        {{ section.settings.heading | default: 'Your wishlist' }}
        <span class="aw-wishlist-page__count" data-aw-wishlist-count hidden>0</span>
      </h1>
    </div>
    <button
      type="button"
      class="aw-wishlist-page__share"
      data-aw-wishlist-share
      data-label-idle="{{ 'general.wishlist.share' | t }}"
      data-label-done="{{ 'general.wishlist.share_link_copied' | t }}"
      data-share-title="{{ 'general.wishlist.share_title' | t }}"
      data-share-text="{{ 'general.wishlist.share_text' | t }}"
      hidden
    >
      {{- 'icon-share.svg' | inline_asset_content -}}
      <span data-aw-wishlist-share-label>{{ 'general.wishlist.share' | t }}</span>
    </button>
  </div>

  <div data-aw-wishlist-empty class="aw-wishlist-page__empty">
    <p>Nothing saved yet. Tap the heart on any product to add it here.</p>
    <a href="{{ section.settings.empty_state_link | default: routes.all_products_collection_url }}" class="link">
      {{ section.settings.empty_state_link_label | default: 'Continue shopping' }}
    </a>
  </div>

  <ul data-aw-wishlist-grid class="aw-wishlist-page__grid grid grid--2-col-tablet-down grid--4-col-desktop" hidden role="list"></ul>
</div>

<div data-aw-wishlist-summary class="aw-wishlist-summary" hidden>
  <div class="aw-wishlist-summary__row">
    <span class="aw-wishlist-summary__label">{{ 'general.wishlist.value_label' | t }}</span>
    <span class="aw-wishlist-summary__price" data-aw-wishlist-summary-total></span>
  </div>
  <p class="aw-wishlist-summary__note">{{ 'general.wishlist.value_note' | t }}</p>
  <button
    type="button"
    class="aw-wishlist-summary__move-all"
    data-aw-wishlist-move-all
    data-label-idle="{{ 'general.wishlist.move_all_to_bag' | t }}"
    data-label-loading="{{ 'general.wishlist.moving_all_to_bag' | t }}"
    data-label-error="{{ 'general.wishlist.move_to_bag_error' | t }}"
  >
    {{ 'general.wishlist.move_all_to_bag' | t }}
  </button>
  <p class="aw-wishlist-summary__footnote">{{ 'general.wishlist.move_all_note' | t }}</p>
</div>

<div id="aw-wishlist-pair"></div>
<script src="{{ 'artwistic-wishlist-recommendations.js' | asset_url }}" defer="defer"></script>

<template id="aw-wishlist-card-template">
  <li class="grid__item aw-wishlist-card">
    <div class="card-wrapper product-card-wrapper">
      <a class="aw-wishlist-card__media-link" href="">
        <div class="aw-wishlist-card__media">
          <img src="" alt="" loading="lazy" width="360" height="450">
        </div>
      </a>
      <div class="aw-wishlist-card__content">
        <a class="aw-wishlist-card__title full-unstyled-link" href=""></a>
        <span
          class="aw-wishlist-card__stock"
          data-aw-wishlist-stock
          data-label-in-stock="{{ 'general.wishlist.in_stock' | t }}"
          data-label-out-of-stock="{{ 'general.wishlist.out_of_stock' | t }}"
          hidden
        ></span>
        <span class="aw-wishlist-card__price-row">
          <span class="aw-wishlist-card__price price"></span>
          <s class="aw-wishlist-card__compare-price" data-aw-wishlist-compare hidden></s>
        </span>
        <div class="aw-wishlist-card__actions">
          <button
            type="button"
            class="button button--secondary aw-wishlist-card__move"
            data-aw-wishlist-move
            data-label-idle="{{ 'general.wishlist.move_to_bag' | t }}"
            data-label-loading="{{ 'general.wishlist.moving_to_bag' | t }}"
            data-label-done="{{ 'general.wishlist.moved_to_bag' | t }}"
            data-label-error="{{ 'general.wishlist.move_to_bag_error' | t }}"
          >
            {{ 'general.wishlist.move_to_bag' | t }}
          </button>
          <button type="button" class="link aw-wishlist-card__remove" data-aw-wishlist-remove>
            {{ 'general.wishlist.remove' | t }}
          </button>
        </div>
      </div>
    </div>
  </li>
</template>

{% schema %}
{
  "name": "ARTWISTIC: Wishlist",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your wishlist"
    },
    {
      "type": "url",
      "id": "empty_state_link",
      "label": "Empty state link",
      "info": "Where \"Continue shopping\" points when the wishlist is empty. Defaults to the all-products collection."
    },
    {
      "type": "text",
      "id": "empty_state_link_label",
      "label": "Empty state link label",
      "default": "Continue shopping"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "ARTWISTIC: Wishlist"
    }
  ]
}
{% endschema %}
