{% comment %}
  ARTWISTIC: Jewellery Education (spec sections 21, 46) — a link grid to
  buying guides / care articles, giving shoppers a low-pressure way to
  build confidence before purchasing, and giving the store real internal
  links to content pages/articles for SEO (spec section 47: Articles →
  Collections → Products). Deliberately just a link grid, not a content
  generator — the merchant supplies real guide content via Pages or the
  Blog; this section only surfaces it. See ARTWISTIC_CHANGELOG.md.
{% endcomment %}

{{ 'artwistic-jewellery-education.css' | asset_url | stylesheet_tag }}

<div class="aw-container aw-education color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  {%- if section.settings.heading != blank -%}
    <div class="aw-education__header">
      <h2 class="aw-education__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="aw-education__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <ul class="aw-education__grid" role="list">
    {%- for block in section.blocks -%}
      {%- if block.type == 'guide' -%}
        <li {{ block.shopify_attributes }}>
          <a href="{{ block.settings.link | default: '#' }}" class="aw-education-card aw-focusable">
            <span class="aw-education-card__icon">
              {{- block.settings.icon | default: 'icon-info.svg' | inline_asset_content -}}
            </span>
            <span class="aw-education-card__title">{{ block.settings.title | escape }}</span>
            {%- if block.settings.description != blank -%}
              <span class="aw-education-card__description">{{ block.settings.description }}</span>
            {%- endif -%}
            <span class="aw-education-card__cta">Read more {{ 'icon-arrow.svg' | inline_asset_content }}</span>
          </a>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "ARTWISTIC: Education",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Jewellery, decoded"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "guide",
      "name": "Guide",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Ring sizing, explained"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link to article or page"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "icon-info.svg", "label": "Info" },
            { "value": "icon-checkmark.svg", "label": "Checkmark" },
            { "value": "icon-heart.svg", "label": "Heart" },
            { "value": "icon-box.svg", "label": "Box" }
          ],
          "default": "icon-info.svg"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ARTWISTIC: Education",
      "blocks": [
        { "type": "guide", "settings": { "title": "Ring sizing, explained", "icon": "icon-info.svg" } },
        { "type": "guide", "settings": { "title": "Caring for your jewellery", "icon": "icon-heart.svg" } },
        { "type": "guide", "settings": { "title": "How to layer necklaces", "icon": "icon-checkmark.svg" } }
      ]
    }
  ]
}
{% endschema %}
