{% comment %}
  ARTWISTIC REVIEWS — a standalone, full-width, freely-reorderable
  section (moved out of the main-product block column so it can be
  dragged anywhere on the page, same as ARTWISTIC: Reels). Renders
  Judge.me's own real review widget — real reviews, real verified-buyer
  badges, their own "was this helpful" vote button, their own
  verified-purchase-aware "Write a review" form — restyled to match the
  approved mockup (see assets/artwistic-reviews.css and .js). Nothing
  here invents review content; if Judge.me has no reviews synced for
  this product yet, its widget renders its own empty state.

  The overall "X.X / 5" rating summary is hidden per the merchant's
  request (assets/artwistic-reviews.css) — per-review ratings, verified
  badges, and the helpful-vote button stay untouched and fully
  functional, since that's Judge.me's own real data/feature.

  NOTE: Judge.me's class names targeted in artwistic-reviews.css/.js
  (.jdgm-rev, .jdgm-rev__body, etc.) are their documented, long-stable
  names — if your Judge.me install renders different markup, adjust the
  selectors there to match what actually appears; every lookup fails
  silently rather than breaking the page.
{% endcomment %}

{{ 'artwistic-reviews.css' | asset_url | stylesheet_tag }}
<script src="{{ 'artwistic-reviews.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="aw-container">
    <div class="aw-reviews" {{ section.shopify_attributes }}>
      <div class="aw-reviews__header">
        <h2 class="aw-reviews__heading">{{ section.settings.heading | default: 'Loved, in their words' }}</h2>
      </div>

      <div class="aw-reviews__hero" data-aw-review-hero hidden></div>

      {%- comment -%}
        Single custom empty-state box — our own message plus the one
        real "Write a Review" trigger (proxies a click to Judge.me's
        real, verified-purchase-aware form). artwistic-reviews.js
        force-hides Judge.me's own native widget markup entirely while
        there are zero real reviews, so nothing else renders here.
      {%- endcomment -%}
      <div class="aw-reviews__empty" data-aw-reviews-empty hidden>
        <p class="aw-reviews__empty-text">Be the first to share your experience</p>
        <button type="button" class="aw-reviews__write-btn" data-aw-write-review>
          {{ section.settings.write_review_text | default: 'Write a Review' }}
        </button>
      </div>

      {%- comment -%} Judge.me's own real manual-install code for the review widget, exactly as provided by the app {%- endcomment -%}
      {%- assign aw_has_legacy_judgeme_widget = false -%}
      {%- if product.metafields.judgeme.widget.size > 20 -%}
        {%- assign aw_has_legacy_judgeme_widget = true -%}
      {%- endif -%}
      <div style="clear:both"></div>
      <div
        id="judgeme_product_reviews"
        class="jdgm-widget jdgm-review-widget"
        data-product-title="{{ product.title | escape }}"
        data-id="{{ product.id }}"
        data-product-id="{{ product.id }}"
        data-widget="review"
        data-auto-install="false"
        data-shop-reviews-count="{{ shop.metafields.judgeme.shop_reviews_count | default: 0 | escape }}"
        data-entry-point="review_widget.js"
        data-entry-key="review-widget/main.js"
      >
        {%- if aw_has_legacy_judgeme_widget -%}
          <div class="jdgm-legacy-widget-content" style="display: none">{{ product.metafields.judgeme.widget }}</div>
        {%- endif -%}
      </div>
      {%- if product.metafields.judgeme.review_widget_data -%}
        <script>
          jdgm.data ||= {};
          jdgm.data.reviewWidget ||= {};
          jdgm.data.reviewWidget[{{ product.id }}] = {{ product.metafields.judgeme.review_widget_data }};
        </script>
      {%- endif -%}
    </div>
  </div>
</div>

<div class="aw-review-lightbox" data-aw-review-lightbox hidden aria-hidden="true">
  <div class="aw-review-lightbox__backdrop" data-aw-review-lightbox-close></div>
  <div class="aw-review-lightbox__dialog" role="dialog" aria-modal="true" aria-label="{{ 'accessibility.close' | t }}">
    <button type="button" class="aw-review-lightbox__close" data-aw-review-lightbox-close aria-label="{{ 'accessibility.close' | t }}">
      {{- 'icon-close.svg' | inline_asset_content -}}
    </button>
    <div class="aw-review-lightbox__avatar" data-aw-review-lightbox-avatar></div>
    <div class="aw-review-lightbox__body">
      <div class="aw-review-lightbox__stars" data-aw-review-lightbox-stars aria-hidden="true"></div>
      <p class="aw-review-lightbox__text" data-aw-review-lightbox-text></p>
      <p class="aw-review-lightbox__author">
        <span data-aw-review-lightbox-author></span><span class="aw-review-lightbox__city" data-aw-review-lightbox-city></span>
      </p>
    </div>
    <div class="aw-review-lightbox__media" data-aw-review-lightbox-media hidden></div>
  </div>
</div>

{% schema %}
{
  "name": "ARTWISTIC: Reviews",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Real reviews via Judge.me (your installed review app) — renders Judge.me's own review widget, restyled to match the site. Only shows on product pages, since a Judge.me review widget is tied to a specific product."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved, in their words"
    },
    {
      "type": "text",
      "id": "write_review_text",
      "label": "\"Write a review\" button text",
      "default": "Write a Review"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "ARTWISTIC: Reviews"
    }
  ]
}
{% endschema %}
