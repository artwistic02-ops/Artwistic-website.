{% comment %}
  ARTWISTIC: Shop This Guide — product recommendations tied to a blog
  article (spec section 47: Articles → Collections → Products internal
  linking). Reuses Dawn's own snippets/card-product.liquid for the cards
  rather than reimplementing a product card, so it inherits all of
  Dawn's card styling/behavior plus the ARTWISTIC wishlist button
  automatically. See ARTWISTIC_CHANGELOG.md.
{% endcomment %}

{{ 'artwistic-jewellery-education.css' | asset_url | stylesheet_tag }}
{% render 'artwistic-section-padding' %}

{%- assign aw_guide_products = section.blocks | where: 'type', 'product' -%}
{%- if aw_guide_products.size > 0 -%}
  <div class="aw-container aw-shop-this-guide color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
    <div class="aw-education__header">
      <h2 class="aw-education__heading">{{ section.settings.heading | default: 'Shop this guide' }}</h2>
    </div>
    <ul class="grid grid--2-col-tablet-down grid--4-col-desktop" role="list">
      {%- for block in aw_guide_products -%}
        {%- if block.settings.product != blank -%}
          <li class="grid__item" {{ block.shopify_attributes }}>
            {%- render 'card-product', card_product: block.settings.product, section_id: section.id -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "ARTWISTIC: Article Shop",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop this guide"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 44
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ARTWISTIC: Article Shop"
    }
  ]
}
{% endschema %}
