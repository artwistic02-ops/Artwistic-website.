{% comment %}
  ARTWISTIC: "Pair it with" cross-sell rail for the cart page/drawer.
  Not referenced in any JSON template — like Dawn's own product
  recommendations, this section is rendered on demand by Shopify's
  recommendation endpoint (routes.product_recommendations_url) when
  fetched with ?section_id=artwistic-cart-recommendations&product_id=X,
  which populates the real `recommendations` object below using
  Shopify's own complementary-products logic. No fabricated picks.

  See assets/artwistic-cart-recommendations.js for the fetch, based on
  the last product added to the cart.
{% endcomment %}

{% if recommendations.performed and recommendations.products_count > 0 %}
  {{ 'component-card.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'artwistic-cart-recommendations.css' | asset_url | stylesheet_tag }}

  <div class="aw-pair">
    <div class="aw-pair__head">
      <span class="aw-eyebrow">{{ section.settings.eyebrow | default: 'Frequently paired' }}</span>
      <h2 class="aw-pair__heading">{{ section.settings.heading | default: 'Pair it with' }}</h2>
    </div>
    <div class="aw-rail-shell">
      <button type="button" class="aw-rail-arrow aw-rail-arrow--prev" data-aw-rail-prev aria-label="Previous">
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </button>
      <ul class="aw-pair__rail" role="list" data-aw-rail>
        {%- for product in recommendations.products limit: section.settings.product_limit -%}
          <li class="aw-pair__item">
            {%- render 'card-product', card_product: product, media_aspect_ratio: 'square', quick_add: 'standard', section_id: section.id -%}
          </li>
        {%- endfor -%}
      </ul>
      <button type="button" class="aw-rail-arrow aw-rail-arrow--next" data-aw-rail-next aria-label="Next">
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </button>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "ARTWISTIC: Cart recommendations",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Frequently paired"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pair it with"
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Maximum products to show",
      "default": 6
    }
  ]
}
{% endschema %}
