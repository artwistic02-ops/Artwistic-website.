{% comment %}
  ARTWISTIC: UGC / social-proof marquee. Desktop: an asymmetric
  6-tile collage grid, looped infinitely. Mobile: two independent
  rows scrolling opposite directions ("living wall"), uniform square
  tiles. Real photos + optional real handle only — never fabricated
  like/follower counts.
{% endcomment %}

{{ 'artwistic-ugc.css' | asset_url | stylesheet_tag }}
<script src="{{ 'artwistic-ugc.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  /* Continuous fluid padding instead of a single 750px jump between
     two fixed values — scales smoothly with viewport width the whole
     way, clamped between the mobile floor and the merchant's set
     desktop value. */
  .section-{{ section.id }}-padding {
    padding-top: clamp(
      {{ section.settings.padding_top | times: 0.75 | round: 0 }}px,
      {{ section.settings.padding_top | divided_by: 12.8 }}vw,
      {{ section.settings.padding_top }}px
    );
    padding-bottom: clamp(
      {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px,
      {{ section.settings.padding_bottom | divided_by: 12.8 }}vw,
      {{ section.settings.padding_bottom }}px
    );
  }
{%- endstyle -%}

{%- if section.blocks.size > 0 -%}
  <div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding aw-ugc-section">
    <div class="aw-container">
      <div class="aw-section-head">
        <h2 class="aw-section-head__title">{{ section.settings.heading | escape }}</h2>
      </div>
    </div>

    {%- comment -%} Desktop: asymmetric collage, repeated 4x for a seamless loop even with few real photos. {%- endcomment -%}
    <div class="aw-ugc-desktop">
      <div class="aw-ugc-track-shell">
        <div class="aw-ugc-track" data-aw-ugc-track>
          {%- for aw_repeat in (1..3) -%}
            {%- for block in section.blocks -%}
              {%- assign aw_pos = forloop.index0 | modulo: 6 -%}
              {%- if aw_pos == 0 -%}<div class="aw-ugc-collage">{%- endif -%}
              <a
                href="{{ block.settings.link | default: '#' }}"
                class="aw-ugc-tile aw-ugc-tile--{{ 'abcdef' | slice: aw_pos, 1 }}"
                {% if aw_repeat == 1 %}{{ block.shopify_attributes }}{% endif %}
              >
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 900
                    | image_tag: loading: 'lazy', widths: '300, 500, 700, 900', class: 'aw-ugc-tile__img'
                  }}
                {%- endif -%}
                {%- if block.settings.handle != blank -%}
                  <span class="aw-ugc-tile__handle">{{ block.settings.handle | escape }}</span>
                {%- endif -%}
              </a>
              {%- if aw_pos == 5 or forloop.last -%}</div>{%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        </div>
      </div>
    </div>

    {%- comment -%} Mobile: two independent rows, opposite scroll direction, square tiles. {%- endcomment -%}
    <div class="aw-ugc-mobile">
      {%- for aw_row in (0..1) -%}
        <div class="aw-ugc-track-shell">
          <div class="aw-ugc-track aw-ugc-track--row{{ aw_row }}" data-aw-ugc-track>
            {%- for aw_repeat in (1..3) -%}
              {%- for block in section.blocks -%}
                {%- assign aw_mod = forloop.index0 | modulo: 2 -%}
                {%- if aw_mod == aw_row -%}
                  <a href="{{ block.settings.link | default: '#' }}" class="aw-ugc-tile">
                    {%- if block.settings.image != blank -%}
                      {{
                        block.settings.image
                        | image_url: width: 500
                        | image_tag: loading: 'lazy', widths: '200, 350, 500', class: 'aw-ugc-tile__img'
                      }}
                    {%- endif -%}
                    {%- if block.settings.handle != blank -%}
                      <span class="aw-ugc-tile__handle">{{ block.settings.handle | escape }}</span>
                    {%- endif -%}
                  </a>
                {%- endif -%}
              {%- endfor -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "ARTWISTIC: UGC Marquee",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "As worn by you"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Handle",
          "info": "Optional, e.g. @customername"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional — e.g. the tagged product."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ARTWISTIC: UGC Marquee",
      "blocks": [
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" }
      ]
    }
  ]
}
{% endschema %}
