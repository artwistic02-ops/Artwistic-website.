{% comment %}
  ARTWISTIC: Build Your Stack (spec section 40). Merchant curates a set of
  products designed to be worn together; the shopper toggles which ones
  they want, sees a running total, and adds every selected item to the
  cart in one action. No fabricated discount — the combined total is
  always the literal sum of the selected products' real prices. If a
  merchant wants an actual bundle discount, that's a real Shopify
  automatic discount applied at checkout, configured in Admin, not
  anything this theme calculates or claims.

  Each product's default variant (selected_or_first_available_variant)
  is what gets added — this build does not support per-item variant
  selection within the stack (documented limitation, see
  ARTWISTIC_CHANGELOG.md).

  See ARTWISTIC_CHANGELOG.md and docs/FEATURE_REGISTER.md.
{% endcomment %}

{{ 'artwistic-stack-builder.css' | asset_url | stylesheet_tag }}
{% render 'artwistic-section-padding' %}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
<script src="{{ 'artwistic-stack-builder.js' | asset_url }}" defer="defer"></script>

<div class="aw-container aw-stack color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  {%- if section.settings.heading != blank -%}
    <div class="aw-stack__header">
      <h2 class="aw-stack__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="aw-stack__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <aw-stack-builder
    data-stack-name="{{ section.settings.heading | default: 'Build Your Stack' | escape }}"
    data-money-format="{{ shop.money_format | escape }}"
    data-cart-url="{{ routes.cart_url }}"
  >
    <ul class="aw-stack__grid" role="list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'product' and block.settings.product != blank -%}
          {%- assign stack_product = block.settings.product -%}
          {%- assign stack_variant = stack_product.selected_or_first_available_variant -%}
          <li class="aw-stack-item" {{ block.shopify_attributes }}>
            <label class="aw-stack-item__label">
              <input
                type="checkbox"
                class="aw-stack-item__checkbox"
                data-stack-item
                data-variant-id="{{ stack_variant.id }}"
                data-price="{{ stack_variant.price }}"
                data-title="{{ stack_product.title | escape }}"
                {% if block.settings.selected_by_default and stack_variant.available %}
                  checked
                {% endif %}
                {% unless stack_variant.available %}
                  disabled
                {% endunless %}
              >
              <span class="aw-stack-item__media">
                {%- if stack_product.featured_media -%}
                  {{ stack_product.featured_media | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200, 300, 400' }}
                {%- else -%}
                  <span class="aw-placeholder aw-stack-item__image-fallback"></span>
                {%- endif -%}
                <span class="aw-stack-item__check" aria-hidden="true">{{ 'icon-checkmark.svg' | inline_asset_content }}</span>
              </span>
              <span class="aw-stack-item__title">{{ stack_product.title | escape }}</span>
              <span class="aw-stack-item__price price">
                {%- if stack_variant.available -%}
                  {{ stack_variant.price | money }}
                {%- else -%}
                  Sold out
                {%- endif -%}
              </span>
            </label>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

    <div class="aw-stack__summary">
      <div class="aw-stack__summary-copy">
        <span data-stack-count>0 pieces selected</span>
        <span class="aw-stack__summary-total" data-stack-total></span>
      </div>
      <button type="button" class="button button--primary" data-stack-submit disabled>
        Add stack to cart
      </button>
      <p class="aw-stack__note" role="status" data-stack-status></p>
    </div>
  </aw-stack-builder>
</div>

{% schema %}
{
  "name": "ARTWISTIC: Build Stack",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build your stack"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Pick a few pieces designed to be worn together."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "checkbox",
          "id": "selected_by_default",
          "label": "Selected by default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ARTWISTIC: Build Stack",
      "blocks": [{ "type": "product" }, { "type": "product" }, { "type": "product" }]
    }
  ]
}
{% endschema %}
