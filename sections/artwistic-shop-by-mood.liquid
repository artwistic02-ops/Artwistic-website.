{% comment %}
  ARTWISTIC: Shop by Mood / Collection (spec section 24) — large-format
  editorial cards for curated collections ("The Everyday Edit", "Golden
  Hour", "After Dark"), distinct from the small tile grids used by Shop
  by Category/Intent since these carry real editorial copy, not just a
  label. Pure block configuration — no metafields/metaobjects required,
  since each card just needs an image, title, description, and a link to
  a real Shopify collection.
  See ARTWISTIC_CHANGELOG.md and docs/FEATURE_REGISTER.md.
{% endcomment %}

{{ 'artwistic-shop-by-mood.css' | asset_url | stylesheet_tag }}
{% render 'artwistic-section-padding' %}

<div class="aw-container aw-shop-by-mood color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  {%- if section.settings.heading != blank -%}
    <div class="aw-shop-by-mood__header">
      <h2 class="aw-shop-by-mood__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="aw-shop-by-mood__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="aw-shop-by-mood__list">
    {%- for block in section.blocks -%}
      {%- if block.type == 'edit' -%}
        <article class="aw-mood-card aw-mood-card--{% cycle 'right', 'left' %}" {{ block.shopify_attributes }}>
          <a href="{{ block.settings.link | default: '#' }}" class="aw-mood-card__media aw-focusable">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1400
                | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 990px) 50vw, 100vw',
                  widths: '480, 720, 1000, 1400',
                  class: 'aw-mood-card__image'
              }}
            {%- else -%}
              <span class="aw-placeholder aw-mood-card__image"></span>
            {%- endif -%}
          </a>
          <div class="aw-mood-card__content">
            {%- if block.settings.eyebrow != blank -%}
              <p class="aw-eyebrow">{{ block.settings.eyebrow | escape }}</p>
            {%- endif -%}
            <h3 class="aw-mood-card__title">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.description != blank -%}
              <p class="aw-mood-card__description">{{ block.settings.description }}</p>
            {%- endif -%}
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="link animate-arrow aw-mood-card__link">
                {{ block.settings.link_label | default: 'Shop the edit' }}
                {{- 'icon-arrow.svg' | inline_asset_content -}}
              </a>
            {%- endif -%}
          </div>
        </article>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "ARTWISTIC: Shop by Mood",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by mood"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "edit",
      "name": "Editorial edit",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow (optional)",
          "default": "New edit"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "The Everyday Edit"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Shop the edit"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ARTWISTIC: Shop by Mood",
      "blocks": [
        { "type": "edit", "settings": { "title": "The Everyday Edit" } },
        { "type": "edit", "settings": { "title": "Golden Hour" } }
      ]
    }
  ]
}
{% endschema %}
