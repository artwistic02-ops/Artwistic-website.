{% comment %}
  ARTWISTIC: Shop by Intent — homepage tile grid for purpose-based
  discovery (Everyday, Gifts, Under a price point, etc. — spec section
  23). Deliberately reuses the tile visual system from
  assets/artwistic-shop-by-category.css (same .aw-category-tile markup)
  rather than duplicating that CSS, since both modules share one "Shop by
  X" visual language — see ARTWISTIC_CHANGELOG.md. Kept as its own
  section file (not merged into Shop by Category) so it shows up as its
  own, clearly-labelled entry in the Theme Editor's section list.
{% endcomment %}

{{ 'artwistic-shop-by-category.css' | asset_url | stylesheet_tag }}
{% render 'artwistic-section-padding' %}

<div class="aw-container aw-shop-by-category color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  {%- if section.settings.heading != blank -%}
    <div class="aw-shop-by-category__header">
      <h2 class="aw-shop-by-category__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="aw-shop-by-category__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <ul
    class="aw-shop-by-category__grid aw-shop-by-category__grid--{{ section.settings.columns_desktop }}-col-desktop aw-shop-by-category__grid--{{ section.settings.columns_mobile }}-col-mobile"
    role="list"
  >
    {%- for block in section.blocks -%}
      {%- if block.type == 'intent' -%}
        <li class="aw-shop-by-category__item" {{ block.shopify_attributes }}>
          <a href="{{ block.settings.link | default: '#' }}" class="aw-category-tile aw-focusable">
            <span
              class="aw-category-tile__media"
              style="aspect-ratio: {{ section.settings.aspect_ratio | replace: 'x', ' / ' }};"
            >
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
                    widths: '360, 540, 720, 900',
                    class: 'aw-category-tile__image aw-category-tile__image--primary'
                }}
              {%- else -%}
                <span class="aw-placeholder aw-category-tile__image aw-category-tile__image--primary"></span>
              {%- endif -%}
            </span>
            <span class="aw-category-tile__caption">
              <span class="aw-category-tile__title">{{ block.settings.title | escape }}</span>
              {%- if block.settings.subtitle != blank -%}
                <span class="aw-category-tile__subtitle">{{ block.settings.subtitle | escape }}</span>
              {%- endif -%}
            </span>
          </a>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "ARTWISTIC: Shop by Intent",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by intent"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" }
      ],
      "default": "5"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile columns",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Tile aspect ratio",
      "options": [
        { "value": "1x1", "label": "Square (1:1)" },
        { "value": "4x5", "label": "Portrait (4:5)" },
        { "value": "3x4", "label": "Portrait (3:4)" }
      ],
      "default": "1x1"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "intent",
      "name": "Intent tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Everyday"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle (optional)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ARTWISTIC: Shop by Intent",
      "blocks": [
        { "type": "intent", "settings": { "title": "Everyday" } },
        { "type": "intent", "settings": { "title": "Gifting" } },
        { "type": "intent", "settings": { "title": "Under ₹1,499" } },
        { "type": "intent", "settings": { "title": "Stackable" } }
      ]
    }
  ]
}
{% endschema %}
