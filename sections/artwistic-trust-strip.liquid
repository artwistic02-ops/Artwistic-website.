{% comment %}
  ARTWISTIC: TRUST STRIP — a row of real merchant-set service claims
  (shipping time, material finish, returns policy, etc.), each with a
  real Dawn icon. Not a stock Dawn section (Dawn has no icon-first claim
  row), built new following the same additive, real-data-only pattern
  as the rest of this theme.

  Real content only: the preset ships with genuinely true starter
  claims, but the merchant is expected to edit each label to match
  their real service before launch — this section never fabricates a
  claim on its own.
{% endcomment %}

{{ 'artwistic-trust-strip.css' | asset_url | stylesheet_tag }}
<script src="{{ 'artwistic-rail.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  /* Continuous fluid padding instead of a single 750px jump between
     two fixed values — scales smoothly with viewport width the whole
     way, clamped between the mobile floor and the merchant's set
     desktop value. */
  .section-{{ section.id }}-padding {
    padding-top: clamp(
      {{ section.settings.padding_top | times: 0.75 | round: 0 }}px,
      {{ section.settings.padding_top | divided_by: 12.8 }}vw,
      {{ section.settings.padding_top }}px
    );
    padding-bottom: clamp(
      {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px,
      {{ section.settings.padding_bottom | divided_by: 12.8 }}vw,
      {{ section.settings.padding_bottom }}px
    );
  }
{%- endstyle -%}

{%- if section.blocks.size > 0 -%}
  <div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
    <div class="aw-trust-strip aw-rail-shell aw-container" data-aw-trust-count="{{ section.blocks.size }}">
      <button type="button" class="aw-rail-arrow aw-rail-arrow--prev" data-aw-rail-prev aria-label="Previous">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M15 4l-8 8 8 8"></path></svg>
      </button>
      <ul class="aw-trust-strip__rail" data-aw-rail role="list">
        {%- for block in section.blocks -%}
          <li class="aw-trust-strip__item" {{ block.shopify_attributes }}>
            <span class="aw-trust-strip__icon">
              {{- block.settings.icon | append: '.svg' | inline_asset_content -}}
            </span>
            <p class="aw-trust-strip__label">{{ block.settings.label | escape }}</p>
          </li>
        {%- endfor -%}
      </ul>
      <button type="button" class="aw-rail-arrow aw-rail-arrow--next" data-aw-rail-next aria-label="Next">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 4l8 8-8 8"></path></svg>
      </button>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "ARTWISTIC: Trust Strip",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "claim",
      "name": "Claim",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "icon-truck", "label": "Truck" },
            { "value": "icon-plane", "label": "Plane" },
            { "value": "icon-box", "label": "Box" },
            { "value": "icon-return", "label": "Return" },
            { "value": "icon-lock", "label": "Lock" },
            { "value": "icon-padlock", "label": "Padlock" },
            { "value": "icon-star", "label": "Star" },
            { "value": "icon-price-tag", "label": "Price tag" },
            { "value": "icon-discount", "label": "Discount" },
            { "value": "icon-leaf", "label": "Leaf" },
            { "value": "icon-recycle", "label": "Recycle" },
            { "value": "icon-heart", "label": "Heart" },
            { "value": "icon-check-mark", "label": "Checkmark" },
            { "value": "icon-checkmark", "label": "Checkmark (alt)" },
            { "value": "icon-stopwatch", "label": "Stopwatch" },
            { "value": "icon-chat-bubble", "label": "Chat bubble" },
            { "value": "icon-map-pin", "label": "Map pin" }
          ],
          "default": "icon-truck"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Dispatched in 24–48 hrs"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ARTWISTIC: Trust Strip",
      "blocks": [
        { "type": "claim", "settings": { "icon": "icon-truck", "label": "Dispatched in 24–48 hrs" } },
        { "type": "claim", "settings": { "icon": "icon-star", "label": "Anti-tarnish finish" } },
        { "type": "claim", "settings": { "icon": "icon-box", "label": "Free shipping above ₹1,499" } },
        { "type": "claim", "settings": { "icon": "icon-return", "label": "Easy 7-day returns" } }
      ]
    }
  ]
}
{% endschema %}
