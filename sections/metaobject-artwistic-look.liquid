{% comment %}
  ARTWISTIC: standalone storefront page for a single Shop the Look
  metaobject entry (Settings → Custom data → Metaobjects → Shop the
  Look → Storefront pages must be enabled — see docs/METAOBJECTS.md).
  Gives "Featured in: [Look name]" links on the product page (see
  snippets/artwistic-complete-the-look.liquid) somewhere real to point
  to, rather than a dead anchor. Reuses the exact same hotspot rendering
  as the homepage Shop the Look rail via snippets/artwistic-look-media.liquid.
  See ARTWISTIC_CHANGELOG.md and docs/METAOBJECTS.md.
{% endcomment %}

{{ 'artwistic-shop-the-look.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

<div class="aw-container aw-shop-the-look color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="aw-shop-the-look__header">
    <h1 class="aw-shop-the-look__heading">{{ metaobject.title.value | escape }}</h1>
    {%- if metaobject.subtitle.value != blank -%}
      <p class="aw-shop-the-look__subheading">{{ metaobject.subtitle.value }}</p>
    {%- endif -%}
  </div>

  <div class="aw-shop-the-look__rail aw-shop-the-look__rail--single">
    <article class="aw-look">
      {%- render 'artwistic-look-media', look: metaobject -%}
    </article>
  </div>
</div>

{% schema %}
{
  "name": "ARTWISTIC: Look page",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 56
    }
  ]
}
{% endschema %}
