{% comment %}
  ARTWISTIC: Shop by Category — visual category discovery grid for the
  homepage (spec section 22). Each tile is a merchant-configurable block:
  image, optional hover image, title, subtitle, link, and an optional
  live product count pulled from a linked collection. No metafields or
  metaobjects required — this is pure section/block configuration so
  merchandising never requires editing Liquid (spec section 78).
  See ARTWISTIC_CHANGELOG.md and docs/FEATURE_REGISTER.md.
{% endcomment %}

{{ 'artwistic-shop-by-category.css' | asset_url | stylesheet_tag }}
{% render 'artwistic-section-padding' %}

<div class="aw-container aw-shop-by-category color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  {%- if section.settings.heading != blank -%}
    <div class="aw-shop-by-category__header">
      <h2 class="aw-shop-by-category__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="aw-shop-by-category__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <ul
    class="aw-shop-by-category__grid aw-shop-by-category__grid--{{ section.settings.columns_desktop }}-col-desktop aw-shop-by-category__grid--{{ section.settings.columns_mobile }}-col-mobile"
    role="list"
  >
    {%- for block in section.blocks -%}
      {%- if block.type == 'category' -%}
        <li class="aw-shop-by-category__item" {{ block.shopify_attributes }}>
          <a href="{{ block.settings.link | default: '#' }}" class="aw-category-tile aw-focusable">
            <span
              class="aw-category-tile__media"
              style="aspect-ratio: {{ section.settings.aspect_ratio | replace: 'x', ' / ' }};"
            >
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
                    widths: '360, 540, 720, 900',
                    class: 'aw-category-tile__image aw-category-tile__image--primary'
                }}
              {%- else -%}
                <span class="aw-placeholder aw-category-tile__image aw-category-tile__image--primary"></span>
              {%- endif -%}
              {%- if block.settings.hover_image != blank -%}
                {{
                  block.settings.hover_image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
                    widths: '360, 540, 720, 900',
                    class: 'aw-category-tile__image aw-category-tile__image--hover'
                }}
              {%- endif -%}
            </span>
            <span class="aw-category-tile__caption">
              <span class="aw-category-tile__title">{{ block.settings.title | escape }}</span>
              {%- if block.settings.subtitle != blank -%}
                <span class="aw-category-tile__subtitle">{{ block.settings.subtitle | escape }}</span>
              {%- endif -%}
              {%- if block.settings.show_count and block.settings.collection != blank -%}
                <span class="aw-category-tile__count">{{ block.settings.collection.all_products_count }} pieces</span>
              {%- endif -%}
            </span>
          </a>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "ARTWISTIC: By Category",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile columns",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Tile aspect ratio",
      "options": [
        { "value": "1x1", "label": "Square (1:1)" },
        { "value": "4x5", "label": "Portrait (4:5)" },
        { "value": "3x4", "label": "Portrait (3:4)" }
      ],
      "default": "4x5"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "hover_image",
          "label": "Hover image (optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle (optional)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "show_count",
          "label": "Show product count",
          "default": false
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection (used for the product count)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ARTWISTIC: By Category",
      "blocks": [
        { "type": "category", "settings": { "title": "Earrings" } },
        { "type": "category", "settings": { "title": "Necklaces" } },
        { "type": "category", "settings": { "title": "Rings" } },
        { "type": "category", "settings": { "title": "Bracelets" } }
      ]
    }
  ]
}
{% endschema %}
