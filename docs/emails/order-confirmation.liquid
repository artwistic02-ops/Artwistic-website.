<!--
  ARTWISTIC — Order Confirmation email

  This is NOT a theme file — Shopify's transactional emails (order
  confirmation, shipping confirmation, etc.) are a separate system from
  the theme, edited in Shopify Admin under Settings → Notifications, with
  their own Liquid context (shop/order/customer/line_items — no access to
  theme `settings.*`, sections, or artwistic-global.css). This file is
  the exact HTML+Liquid to paste into that editor. See
  docs/SHOPIFY_ADMIN_SETUP.md for the install steps and how to test it
  before it goes live.

  Design notes:
  - Table-based layout + fully inline CSS, since most email clients
    (Outlook in particular) don't reliably support CSS Grid/Flexbox or
    external/embedded stylesheets.
  - Colors are literal hex values matching the ARTWISTIC palette
    (--aw-color-* tokens in the theme), not CSS custom properties —
    email clients don't support those either.
  - Web-safe font stacks only (Georgia for headings, Helvetica/Arial for
    body) — a custom Google Font would silently fail in most inboxes, so
    this doesn't attempt to load one, matching standard email practice.
  - Uses Shopify's standard, long-stable order-notification Liquid
    variables (shop, order_name, customer, line_items, shipping_address,
    billing_address, subtotal_price, total_price, total_tax,
    shipping_price, order.order_status_url). Verify with Shopify's
    "Preview" and "Send test email" buttons before relying on it in
    production — this build environment has no live store to test
    against, so treat this as a strong starting point to confirm, not a
    guaranteed-final render.
-->
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ shop.name }} — Order Confirmation</title>
</head>
<body style="margin:0; padding:0; background-color:#ede9e0; font-family:Helvetica, Arial, sans-serif;">

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#ede9e0;">
    <tr>
      <td align="center" style="padding:32px 16px;">

        <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px; width:100%; background-color:#f7f5ef;">

          <!-- Header / wordmark -->
          <tr>
            <td align="center" style="padding:36px 24px 28px; border-bottom:1px solid #e1dccf;">
              <!-- Swap this text wordmark for a logo image once one exists in Admin → Content → Files:
                   <img src="https://cdn.shopify.com/s/files/.../logo.png" width="160" alt="{{ shop.name }}" style="display:block; border:0;"> -->
              <span style="font-family:Georgia, 'Times New Roman', serif; font-size:22px; letter-spacing:0.02em; color:#221e19;">{{ shop.name }}</span>
            </td>
          </tr>

          <!-- Greeting -->
          <tr>
            <td style="padding:32px 32px 8px;">
              <h1 style="margin:0; font-family:Georgia, 'Times New Roman', serif; font-weight:400; font-size:24px; color:#221e19;">Thank you, {{ customer.first_name }}</h1>
              <p style="margin:10px 0 0; font-size:14px; line-height:1.6; color:#6e6455;">
                Your order has been confirmed. We'll let you know as soon as it ships.
              </p>
            </td>
          </tr>

          <!-- Order meta -->
          <tr>
            <td style="padding:16px 32px 0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size:13px; color:#6e6455;">
                <tr>
                  <td style="padding:4px 0;">Order</td>
                  <td align="right" style="padding:4px 0; color:#221e19; font-weight:bold;">{{ order_name }}</td>
                </tr>
                <tr>
                  <td style="padding:4px 0;">Date</td>
                  <td align="right" style="padding:4px 0; color:#221e19;">{{ order.created_at | date: '%d %B %Y' }}</td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Line items -->
          <tr>
            <td style="padding:24px 32px 0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                {%- for line in line_items -%}
                <tr>
                  <td width="72" style="padding:12px 0; border-top:1px solid #e1dccf; vertical-align:top;">
                    {%- if line.image -%}
                      <img src="{{ line.image | img_url: '120x150' }}" width="64" alt="{{ line.title | escape }}" style="display:block; border:0; border-radius:2px; background-color:#ede9e0;">
                    {%- endif -%}
                  </td>
                  <td style="padding:12px 0 12px 14px; border-top:1px solid #e1dccf; vertical-align:top; font-size:14px; color:#221e19;">
                    {{ line.title }}
                    {%- if line.variant_title %}<br><span style="font-size:12px; color:#6e6455;">{{ line.variant_title }}</span>{% endif -%}
                    <br><span style="font-size:12px; color:#6e6455;">Qty {{ line.quantity }}</span>
                  </td>
                  <td align="right" style="padding:12px 0; border-top:1px solid #e1dccf; vertical-align:top; font-size:14px; color:#221e19; white-space:nowrap;">
                    {{ line.final_line_price | money }}
                  </td>
                </tr>
                {%- endfor -%}
              </table>
            </td>
          </tr>

          <!-- Totals -->
          <tr>
            <td style="padding:8px 32px 0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size:13px; color:#6e6455; margin-top:8px;">
                <tr>
                  <td style="padding:4px 0;">Subtotal</td>
                  <td align="right" style="padding:4px 0; color:#221e19;">{{ subtotal_price | money }}</td>
                </tr>
                {%- if shipping_price and shipping_price != 0 -%}
                <tr>
                  <td style="padding:4px 0;">Shipping</td>
                  <td align="right" style="padding:4px 0; color:#221e19;">{{ shipping_price | money }}</td>
                </tr>
                {%- endif -%}
                {%- if total_tax and total_tax != 0 -%}
                <tr>
                  <td style="padding:4px 0;">Tax</td>
                  <td align="right" style="padding:4px 0; color:#221e19;">{{ total_tax | money }}</td>
                </tr>
                {%- endif -%}
                <tr>
                  <td style="padding:10px 0 0; border-top:1px solid #e1dccf; font-size:15px; font-weight:bold; color:#221e19;">Total</td>
                  <td align="right" style="padding:10px 0 0; border-top:1px solid #e1dccf; font-size:15px; font-weight:bold; color:#221e19;">{{ total_price | money }}</td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- CTA -->
          <tr>
            <td align="center" style="padding:32px 32px 8px;">
              <a href="{{ order.order_status_url }}" style="display:inline-block; padding:14px 28px; background-color:#8b6b35; color:#fbf8f2; font-size:14px; font-weight:bold; text-decoration:none; border-radius:2px;">
                View your order
              </a>
            </td>
          </tr>

          <!-- Shipping address -->
          {%- if shipping_address -%}
          <tr>
            <td style="padding:32px 32px 0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td width="50%" style="padding-right:12px; vertical-align:top;">
                    <p style="margin:0 0 6px; font-size:11px; letter-spacing:0.08em; text-transform:uppercase; color:#a89b85;">Shipping to</p>
                    <p style="margin:0; font-size:13px; line-height:1.6; color:#221e19;">
                      {{ shipping_address.name }}<br>
                      {{ shipping_address.address1 }}<br>
                      {%- if shipping_address.address2 != blank %}{{ shipping_address.address2 }}<br>{% endif -%}
                      {{ shipping_address.city }}, {{ shipping_address.province_code }} {{ shipping_address.zip }}<br>
                      {{ shipping_address.country }}
                    </p>
                  </td>
                  <td width="50%" style="padding-left:12px; vertical-align:top;">
                    <p style="margin:0 0 6px; font-size:11px; letter-spacing:0.08em; text-transform:uppercase; color:#a89b85;">Contact</p>
                    <p style="margin:0; font-size:13px; line-height:1.6; color:#221e19;">
                      {{ email }}<br>
                      {%- if shipping_address.phone != blank %}{{ shipping_address.phone }}{% endif -%}
                    </p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          {%- endif -%}

          <!-- Footer -->
          <tr>
            <td style="padding:36px 32px 32px; margin-top:24px; border-top:1px solid #e1dccf;">
              <p style="margin:24px 0 0; font-size:12px; line-height:1.6; color:#a89b85; text-align:center;">
                Questions about your order? Reply to this email or reach us at {{ shop.email }}.<br>
                {{ shop.name }} · {{ shop.url }}
              </p>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>
